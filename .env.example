# Copy this file to `.env` and fill in your own key.
# OpenRouter is the default backend for both generate.py and code.py.
# Sign up at https://openrouter.ai and create a key, then paste it below.
OPENROUTER_API_KEY=

# Optional. Only required when --client local is used to load gated
# Hugging Face checkpoints (e.g. google/gemma-3-12b-it).
# HF_TOKEN=
